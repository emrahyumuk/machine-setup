<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  [role] SETUP.md §3b "UTM VM at login": keep the UTM VM "Home Assistant"
  running. At login (RunAtLoad) and every 120 s after, utm-ha-watchdog starts
  the VM when it is stopped — UTM quit or the VM shut down while the session
  stays logged in (2026-10-22: UTM quit by accident, nothing brought HA back).
  It never stops anything and never touches another VM. UTM is a user app, so
  this needs the console session (an update restart logs in by itself; an
  unplanned one stops at FileVault). The first run asks once for Automation
  permission (utmctl → UTM) on the Mac's screen.
  Installed to ~/Library/LaunchAgents/ by os/macos/bootstrap.sh in server mode,
  which replaces __HOME__ with $HOME (launchd does not expand ~ or $HOME).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.machine-setup.utm-vm</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/utm-ha-watchdog</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>120</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/machine-setup-utm-vm.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/machine-setup-utm-vm.log</string>
</dict>
</plist>
