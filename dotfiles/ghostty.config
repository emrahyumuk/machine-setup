theme = Catppuccin Mocha
font-family = JetBrainsMono Nerd Font
font-size = 12

window-padding-x = 10
window-padding-y = 8
background-opacity = 0.96
cursor-style = block
copy-on-select = clipboard
confirm-close-surface = false

# epoll instead of io_uring: io_uring waits are counted as I/O wait, which made the
# whole system look I/O-stalled (2026-10-22). Ghostty docs: no measurable difference.
# Takes effect after a full Ghostty restart.
async-backend = epoll
